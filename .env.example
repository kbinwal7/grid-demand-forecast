# Local PostgreSQL 16 Compose credentials.
POSTGRES_USER=gridcast_admin
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=gridcast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Write connection used only by schema initialization and forecast-loading jobs.
ADMIN_DATABASE_URL=postgresql+psycopg://gridcast_admin:replace-with-a-strong-local-password@localhost:5432/gridcast

# Read-only connection used by the web app. Use a Neon pooled URL in production.
DATABASE_URL=postgresql+psycopg://gridcast_reader:replace-with-a-different-strong-password@localhost:5432/gridcast
APP_DB_USER=gridcast_reader
APP_DB_PASSWORD=replace-with-a-different-strong-password

# Comma-separated trusted browser hosts; keep *.onrender.com for Render.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.onrender.com
RATE_LIMIT=60/minute
